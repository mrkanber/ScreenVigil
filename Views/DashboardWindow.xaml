<Window x:Class="ScreenVigil.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenVigil" Height="500" Width="420"
        Background="#1A1A19"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="This Session" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="Since the app was launched" FontSize="12" Foreground="#898781" Margin="0,26,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C3C2B7" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="White" FontSize="13" FontFamily="Consolas" Margin="8,0,0,0"/>
                            </Grid>

                            <Border Grid.Row="1" Height="8" CornerRadius="4" Background="#2C2C2A" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                                <Border Height="8" CornerRadius="4" Background="{Binding Color}" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
